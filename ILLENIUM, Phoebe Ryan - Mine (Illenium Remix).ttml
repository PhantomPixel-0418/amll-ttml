<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Phoebe Ryan</songwriter><songwriter>Kyle Shearer</songwriter><songwriter>Nathaniel Campany</songwriter></songwriters></iTunesMetadata><amll:meta key="musicName" value="Mine (Illenium Remix)"/><amll:meta key="musicName" value="Mine (Remix)"/><amll:meta key="artists" value="ILLENIUM"/><amll:meta key="artists" value="Phoebe Ryan"/><amll:meta key="album" value="Mine (ILLENIUM Remix)"/><amll:meta key="album" value="Mine (Remix)"/><amll:meta key="ncmMusicId" value="30780496"/><amll:meta key="qqMusicId" value="001eZJB14ALyBx"/><amll:meta key="appleMusicId" value="1788214329"/><amll:meta key="ttmlAuthorGithub" value="158539001"/><amll:meta key="ttmlAuthorGithubLogin" value="PhantomPixel-0418"/></metadata></head><body dur="03:34.181"><div begin="00:20.940" end="03:34.181"><p begin="00:20.940" end="00:22.515" ttm:agent="v1" itunes:key="L1"><span begin="00:20.940" end="00:21.255">When</span> <span begin="00:21.255" end="00:21.495">it</span> <span begin="00:21.495" end="00:21.860">went</span> <span begin="00:21.860" end="00:22.515">down</span><span ttm:role="x-translation" xml:lang="zh-CN">当我堕落的时候</span></p><p begin="00:23.365" end="00:25.810" ttm:agent="v1" itunes:key="L2"><span begin="00:23.365" end="00:23.552">It</span> <span begin="00:23.552" end="00:23.788">was</span> <span begin="00:23.788" end="00:24.270">so</span> <span begin="00:24.270" end="00:24.866">hard</span> <span begin="00:24.866" end="00:25.201">to</span> <span begin="00:25.201" end="00:25.810">breathe</span><span ttm:role="x-translation" xml:lang="zh-CN">我被桎梏在这无形的悲伤里 喘不过气</span></p><p begin="00:25.810" end="00:28.790" ttm:agent="v1" itunes:key="L3"><span begin="00:25.810" end="00:26.101">I</span> <span begin="00:26.101" end="00:26.430">gave</span> <span begin="00:26.430" end="00:26.729">up</span> <span begin="00:26.729" end="00:27.860">everything</span><span ttm:role="x-bg" begin="00:27.938" end="00:28.790"><span begin="00:27.938" end="00:28.790">(Everything)</span><span ttm:role="x-translation" xml:lang="zh-CN">一切</span></span><span ttm:role="x-translation" xml:lang="zh-CN">曾经为此放弃一切</span></p><p begin="00:28.526" end="00:32.200" ttm:agent="v1" itunes:key="L4"><span begin="00:28.526" end="00:28.791">And</span> <span begin="00:28.791" end="00:28.891">I</span> <span begin="00:28.891" end="00:29.616">slow</span> <span begin="00:29.965" end="00:30.584">fall</span> <span begin="00:30.584" end="00:30.902">down</span> <span begin="00:30.902" end="00:31.239">to</span> <span begin="00:31.239" end="00:31.376">the</span> <span begin="00:31.376" end="00:32.200">floor</span><span ttm:role="x-translation" xml:lang="zh-CN">我缓缓坠向地面</span></p><p begin="00:33.020" end="00:35.250" ttm:agent="v1" itunes:key="L5"><span begin="00:33.020" end="00:33.275">Life</span> <span begin="00:33.275" end="00:33.730">was</span> <span begin="00:33.730" end="00:34.915">escaping</span> <span begin="00:34.915" end="00:35.250">me</span><span ttm:role="x-translation" xml:lang="zh-CN">眼睁睁看着生命从我眼前溜走</span></p><p begin="00:35.500" end="00:37.626" ttm:agent="v1" itunes:key="L6"><span begin="00:35.500" end="00:35.782">I</span> <span begin="00:35.782" end="00:36.250">couldn't</span> <span begin="00:36.250" end="00:36.716">find</span> <span begin="00:36.716" end="00:37.626">myself</span><span ttm:role="x-translation" xml:lang="zh-CN">我迷失了自己 如堕烟海</span></p><p begin="00:37.895" end="00:40.080" ttm:agent="v1" itunes:key="L7"><span begin="00:37.895" end="00:38.238">'Til</span> <span begin="00:38.238" end="00:38.507">it</span> <span begin="00:38.507" end="00:38.888">was</span> <span begin="00:38.888" end="00:39.354">all</span> <span begin="00:39.740" end="00:40.080">lost</span><span ttm:role="x-translation" xml:lang="zh-CN">在我失去一切之前</span></p><p begin="00:40.080" end="00:41.550" ttm:agent="v1" itunes:key="L8"><span begin="00:40.080" end="00:40.656">Not</span> <span begin="00:40.656" end="00:41.550">anymore</span><span ttm:role="x-translation" xml:lang="zh-CN">我要勇敢地去把这一切拿回来</span></p><p begin="00:42.310" end="00:47.513" ttm:agent="v1" itunes:key="L9"><span begin="00:42.310" end="00:42.488">I'm</span> <span begin="00:42.488" end="00:42.916">holding</span> <span begin="00:42.916" end="00:43.066">on</span> <span begin="00:43.066" end="00:43.326">to</span> <span begin="00:43.326" end="00:43.501">all</span> <span begin="00:43.501" end="00:43.681">the</span> <span begin="00:43.681" end="00:44.292">pieces</span> <span begin="00:44.292" end="00:44.737">of</span> <span begin="00:44.737" end="00:44.902">my</span> <span begin="00:44.902" end="00:45.338">heart's</span> <span begin="00:45.338" end="00:46.100">debris</span><span ttm:role="x-bg" begin="00:45.840" end="00:47.513"><span begin="00:45.840" end="00:45.955">(Of</span> <span begin="00:45.955" end="00:46.095">my</span> <span begin="00:46.095" end="00:46.625">heart's</span> <span begin="00:46.625" end="00:47.513">debris)</span><span ttm:role="x-translation" xml:lang="zh-CN">我那支离破碎的心</span></span><span ttm:role="x-translation" xml:lang="zh-CN">咬紧牙关 握紧我那支离破碎的心</span></p><p begin="00:47.332" end="00:49.146" ttm:agent="v1" itunes:key="L10"><span begin="00:47.332" end="00:47.851">'Til</span> <span begin="00:47.851" end="00:48.191">it's</span> <span begin="00:48.191" end="00:49.146">time</span><span ttm:role="x-translation" xml:lang="zh-CN">直到最后一刻</span></p><p begin="00:50.326" end="00:56.835" ttm:agent="v1" itunes:key="L11"><span begin="00:50.326" end="00:51.099">I'll,</span> <span begin="00:51.959" end="00:52.184">I'll</span> <span begin="00:52.184" end="00:52.439">pull</span> <span begin="00:52.439" end="00:52.580">it</span> <span begin="00:52.580" end="00:53.156">together</span> <span begin="00:53.156" end="00:53.449">and</span> <span begin="00:53.449" end="00:53.772">fix</span> <span begin="00:53.772" end="00:54.429">myself</span> <span begin="00:54.429" end="00:56.133">eventually</span><span ttm:role="x-bg" begin="00:55.780" end="00:56.835"><span begin="00:55.780" end="00:56.835">(Eventually)</span><span ttm:role="x-translation" xml:lang="zh-CN">终会不药而愈</span></span><span ttm:role="x-translation" xml:lang="zh-CN">我会将它一一拼凑 最后不药而愈</span></p><p begin="00:56.835" end="00:58.830" ttm:agent="v1" itunes:key="L12"><span begin="00:56.835" end="00:57.029">I</span> <span begin="00:57.029" end="00:57.569">know</span> <span begin="00:57.569" end="00:57.921">it's</span> <span begin="00:57.921" end="00:58.830">mine</span><span ttm:role="x-translation" xml:lang="zh-CN">我知道这是属于我的</span></p><p begin="00:59.128" end="01:01.586" ttm:agent="v1" itunes:key="L13"><span begin="00:59.128" end="00:59.246">I</span> <span begin="00:59.246" end="00:59.694">found</span> <span begin="00:59.694" end="01:00.011">gold</span> <span begin="01:00.011" end="01:00.292">in</span> <span begin="01:00.292" end="01:00.636">the</span> <span begin="01:00.636" end="01:01.586">wreckage</span><span ttm:role="x-translation" xml:lang="zh-CN">我在残垣断壁间拾到闪亮的金子</span></p><p begin="01:01.846" end="01:03.979" ttm:agent="v1" itunes:key="L14"><span begin="01:01.846" end="01:02.148">Put</span> <span begin="01:02.148" end="01:02.475">it</span> <span begin="01:02.475" end="01:02.766">on</span> <span begin="01:02.766" end="01:03.081">a</span> <span begin="01:03.081" end="01:03.979">necklace</span><span ttm:role="x-translation" xml:lang="zh-CN">将它做成一串项链</span></p><p begin="01:04.260" end="01:08.567" ttm:agent="v1" itunes:key="L15"><span begin="01:04.260" end="01:04.902">Keepin'</span> <span begin="01:04.902" end="01:05.180">it</span> <span begin="01:05.180" end="01:05.549">'cause</span> <span begin="01:05.549" end="01:05.812">I-</span><span begin="01:06.079" end="01:06.400">I-</span><span begin="01:06.723" end="01:07.198">I,</span> <span begin="01:07.198" end="01:07.318">I</span> <span begin="01:07.318" end="01:07.469">know</span> <span begin="01:07.469" end="01:07.620">that</span> <span begin="01:07.620" end="01:07.885">it's</span> <span begin="01:07.885" end="01:08.567">mine</span><span ttm:role="x-translation" xml:lang="zh-CN">好好地保管它 因为我知道这是属于我的</span></p><p begin="01:08.854" end="01:11.240" ttm:agent="v1" itunes:key="L16"><span begin="01:08.854" end="01:09.092">I</span> <span begin="01:09.092" end="01:09.419">wear</span> <span begin="01:09.419" end="01:09.581">it</span> <span begin="01:09.581" end="01:09.902">like</span> <span begin="01:09.902" end="01:10.336">a</span> <span begin="01:10.336" end="01:11.240">message</span><span ttm:role="x-translation" xml:lang="zh-CN">这是我存在的痕迹</span></p><p begin="01:11.495" end="01:13.596" ttm:agent="v1" itunes:key="L17"><span begin="01:11.495" end="01:11.903">So</span> <span begin="01:11.903" end="01:12.140">I</span> <span begin="01:12.140" end="01:12.309">don't</span> <span begin="01:12.309" end="01:13.298">forget</span> <span begin="01:13.298" end="01:13.596">it</span><span ttm:role="x-translation" xml:lang="zh-CN">所以我永远不会忘记它</span></p><p begin="01:13.980" end="01:18.445" ttm:agent="v1" itunes:key="L18"><span begin="01:13.980" end="01:14.587">Keepin'</span> <span begin="01:14.587" end="01:14.887">it</span> <span begin="01:14.887" end="01:15.218">'cause</span> <span begin="01:15.218" end="01:15.467">I-</span><span begin="01:15.761" end="01:16.083">I-</span><span begin="01:16.389" end="01:16.863">I,</span> <span begin="01:16.863" end="01:17.026">I</span> <span begin="01:17.026" end="01:17.172">know</span> <span begin="01:17.172" end="01:17.317">that</span> <span begin="01:17.317" end="01:17.587">it's</span> <span begin="01:17.587" end="01:18.445">mine</span><span ttm:role="x-translation" xml:lang="zh-CN">好好地保管它 因为我知道这是属于我的</span></p><p begin="01:19.305" end="01:23.079" ttm:agent="v1" itunes:key="